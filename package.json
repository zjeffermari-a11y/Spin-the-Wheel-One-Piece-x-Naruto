{
  "name": "spin-your-destiny-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:web && npm run build:server",
    "start": "node scripts/start-server.mjs",
    "lint": "oxlint",
    "test": "node --import tsx --test tests/*.test.js",
    "preview": "vite preview",
    "build:web": "vite build && node scripts/build-pwa.mjs",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-server/server.cjs",
    "test:browser": "playwright test",
    "build:native": "node scripts/build-native.mjs",
    "native:doctor": "node scripts/native-doctor.mjs",
    "tauri": "node scripts/run-tauri.mjs",
    "desktop:dev": "node scripts/run-tauri.mjs dev",
    "desktop:build": "node scripts/run-tauri.mjs build",
    "android:init": "node scripts/run-tauri.mjs android init",
    "android:dev": "node scripts/run-tauri.mjs android dev",
    "android:build": "node scripts/run-tauri.mjs android build"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@google/genai": "^2.23.0",
    "@supabase/supabase-js": "^2.113.0",
    "@tailwindcss/vite": "^4.3.3",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "framer-motion": "^13.4.0",
    "html-to-image": "^1.11.13",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.38.0",
    "openai": "^7.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "vite": "^8.2.2"
  }
}
