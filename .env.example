# Public browser/native configuration. Never put provider secrets in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Blank means same-origin for web. Installed apps need the deployed HTTPS API URL.
VITE_API_BASE_URL=

# Server only. Local character generation works without these.
GROQ_API_KEY=
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
PORT=3000
